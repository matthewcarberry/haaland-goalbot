# Discord application token: https://discord.com/developers/applications
DISCORD_TOKEN=
# The text channel where goal announcements should be sent
DISCORD_CHANNEL_ID=
# Optional but recommended: guild/server ID for instant slash-command registration
# Leave blank to register globally; global commands can take up to an hour to appear.
DISCORD_GUILD_ID=

# API-Football key: https://dashboard.api-football.com/register
API_FOOTBALL_KEY=
# Premier League, Manchester City, and optional Haaland IDs in API-Football
API_FOOTBALL_LEAGUE_ID=39
# Comma-separated competitions: 39 Premier League, 48 EFL Cup, 2 UEFA Champions League.
API_FOOTBALL_LEAGUE_IDS=39,48,2,5,10
API_FOOTBALL_TEAM_ID=50
API_FOOTBALL_TEAM_IDS=50,1090
# Leave blank to match the scorer by name; API-Football IDs are provider-specific.
API_FOOTBALL_PLAYER_ID=

# Defaults to the current Premier League season (for example, 2026 for 2026-27).
PL_SEASON=
# Optional local GIF library. Direct child files ending in .gif or .webp are included.
# Relative paths are resolved from the project directory.
GIF_DIRECTORY=gifs

# Optional comma-separated list of direct, publicly reachable GIF URLs.
# Local files and these URLs are combined into one random pool.
GIF_URLS=

# Montage output format for the Reddit highlight worker
REDDIT_MONTAGE_FORMAT=webp
# Optional Reddit OAuth credentials. Leave blank to keep the worker disabled.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=haaland-goal-bot/1.0
REDDIT_SUBREDDITS=MCFC,soccer
# Posts are selected by title; each selected post must contain a direct Reddit video URL.
REDDIT_TITLE_PATTERN=haaland|erling
REDDIT_POLL_INTERVAL_SECONDS=300
REDDIT_CLIP_DIRECTORY=data/reddit-clips
REDDIT_MAX_CLIPS=20
REDDIT_MONTAGE_MAX_SECONDS=60

# Optional Tenor provider. Tenor says new API clients are not currently being accepted.
TENOR_API_KEY=
TENOR_CLIENT_KEY=haaland-goal-tracker
TENOR_QUERY=Erling Haaland goal celebration football

# Polling and persistence
POLL_INTERVAL_SECONDS=90
# Discord's default upload limit is 8 MiB; larger local files are skipped.
MAX_GIF_FILE_BYTES=8388608
DATA_DIR=data
# false prevents a restart from reposting goals that happened before first startup
BACKFILL_DAYS=7
BACKFILL_EXISTING_GOALS=false
