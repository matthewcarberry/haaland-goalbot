# Copy this file to .env on the Unraid share and fill in the private values.
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=

API_FOOTBALL_KEY=
API_FOOTBALL_LEAGUE_ID=39
API_FOOTBALL_LEAGUE_IDS=39,48,2,5,10
API_FOOTBALL_TEAM_ID=50
API_FOOTBALL_TEAM_IDS=50,1090
# Optional provider-specific ID; name matching is used when blank.
API_FOOTBALL_PLAYER_ID=
PL_SEASON=2026

# Docker paths are supplied by docker-compose.yml.
GIF_DIRECTORY=/app/gifs
DATA_DIR=/app/data
REDDIT_CLIP_DIRECTORY=/app/data/reddit-clips
REDDIT_MONTAGE_FORMAT=webp

# Optional Reddit API credentials; leave blank to disable Reddit monitoring.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=haaland-goal-bot/1.0
REDDIT_SUBREDDITS=MCFC,soccer
REDDIT_TITLE_PATTERN=haaland|erling
REDDIT_POLL_INTERVAL_SECONDS=300
REDDIT_MAX_CLIPS=20
REDDIT_MONTAGE_MAX_SECONDS=60

POLL_INTERVAL_SECONDS=90
MAX_GIF_FILE_BYTES=8388608
BACKFILL_DAYS=7
BACKFILL_EXISTING_GOALS=false

# GitHub Container Registry login for pulling the private bot image (used by docker-compose.yml).
# GHCR_TOKEN is a GitHub personal access token (classic) with only the read:packages scope.
GHCR_USERNAME=matthewcarberry
GHCR_TOKEN=

# Optional public URL of the container icon shown on the Unraid Docker page.
# Defaults to assets/unraid-icon.png on GitHub, which only loads while the repository is public.
UNRAID_ICON_URL=
